{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "jeffh-claude-plugins",
  "version": "1.3.0",
  "description": "Various Plugins for Claude Code",
  "owner": {
    "name": "Jeff Hui",
    "email": "jeff@jeffhui.net"
  },
  "plugins": [
    {
      "name": "discuss",
      "description": "Interactive discussion workflows for planning features, creating reference docs, and clarifying thoughts through iterative Q&A",
      "source": "./discuss",
      "category": "productivity",
      "version": "2026-01-12",
      "author": {
        "name": "Jeff Hui",
        "email": "jeff@jeffhui.net"
      }
    },
    {
      "name": "humanlayer",
      "description": "Commands and agents from humanlayer, but without the thought syncing",
      "source": "./humanlayer",
      "category": "development",
      "version": "2026-02-16",
      "author": {
        "name": "HumanLayer"
      }
    },
    {
      "name": "codex",
      "description": "Delegate implement, review, and computer-use tasks to a Codex (GPT) subagent, with support for choosing the GPT model",
      "source": "./codex",
      "category": "development",
      "version": "2026-07-09",
      "author": {
        "name": "Jeff Hui",
        "email": "jeff@jeffhui.net"
      }
    },
    {
      "name": "jj",
      "description": "Jujutsu (jj) version control commands",
      "source": "./jj",
      "category": "development",
      "version": "2026-02-16",
      "author": {
        "name": "Jeff Hui",
        "email": "jeff@jeffhui.net"
      }
    },
    {
      "name": "gh",
      "description": "GitHub CLI operations and repository management",
      "source": "./gh",
      "category": "development",
      "version": "2025-12-15",
      "author": {
        "name": "Jeff Hui",
        "email": "jeff@jeffhui.net"
      }
    },
    {
      "name": "pai",
      "description": "Personal AI Infrastructure - 13 principles for deterministic, CLI-first AI with specialized agents and full history capture",
      "source": "./pai",
      "category": "productivity",
      "version": "2025-12-26",
      "author": {
        "name": "Jeff Hui",
        "email": "jeff@jeffhui.net"
      },
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/session-capture.ts\""
              },
              {
                "type": "command",
                "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/event-capture.ts\""
              }
            ]
          }
        ],
        "SessionEnd": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/session-capture.ts\""
              },
              {
                "type": "command",
                "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/event-capture.ts\""
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/event-capture.ts\""
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "matcher": "*",
            "hooks": [
              {
                "type": "command",
                "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/event-capture.ts\""
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "*",
            "hooks": [
              {
                "type": "command",
                "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/event-capture.ts\""
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/event-capture.ts\""
              }
            ]
          }
        ],
        "SubagentStop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/event-capture.ts\""
              }
            ]
          }
        ],
        "PreCompact": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bun run \"${CLAUDE_PLUGIN_ROOT}/hooks/event-capture.ts\""
              }
            ]
          }
        ]
      }
    }
  ]
}
